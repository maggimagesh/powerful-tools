#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    python3 -m compileall -q /usr/lib/powerful-tools >/dev/null 2>&1 || true
    # Touchpad Gestures: give the logged-in user read access to touchpads now, not only after a reboot
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules >/dev/null 2>&1 || true
        udevadm trigger --subsystem-match=input --action=change >/dev/null 2>&1 || true
    fi
fi
exit 0
